NODE_ENV=production

# --- Baza Danych PostgreSQL ---
POSTGRES_DB=booking_db
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mysecretpassword123
DB_HOST=postgresql
DB_PORT=5432
DB_NAME=${POSTGRES_DB} 
DB_USER=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret_pass

# --- RabbitMQ ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_DEFAULT_USER=user
RABBITMQ_DEFAULT_PASS=rabbit_secret_pass
RABBITMQ_USER=${RABBITMQ_DEFAULT_USER} 
RABBITMQ_PASS=${RABBITMQ_DEFAULT_PASS}

JWT_SECRET=super-tajny-klucz
JWT_EXPIRES_IN=1h

# User Service
USER_SERVICE_PORT=3003
USER_SERVICE_URL=http://user-service:3003

# Booking Core Service
CORE_SERVICE_PORT=3001
CORE_SERVICE_URL=http://booking-core-service:3001

# Booking API
API_PORT=3000

# --- Konfiguracja Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KC_DB=postgres
KC_DB_URL_HOST=postgresql
KC_DB_URL_DATABASE=keycloak_db
KC_DB_USERNAME=${POSTGRES_USER}
KC_DB_PASSWORD=${POSTGRES_PASSWORD}
KC_DB_SCHEMA=public
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_STRICT_HTTPS=false
KC_HTTP_ENABLED=true
KC_HTTP_PORT=8180
KC_PROXY=edge
KEYCLOAK_REALM_NAME=booking-app-realm
KEYCLOAK_PUBLIC_URL_BASE=http://localhost:8180
KEYCLOAK_REALM_URL=${KEYCLOAK_PUBLIC_URL_BASE}/realms/${KEYCLOAK_REALM_NAME}

# Booking UI
APP_KEYCLOAK_URL=${KEYCLOAK_PUBLIC_URL_BASE}
APP_KEYCLOAK_REALM=${KEYCLOAK_REALM_NAME}
APP_KEYCLOAK_CLIENT_ID=booking-ui-client